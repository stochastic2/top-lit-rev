@article{pan_exact_1999,
	title = {Exact {Quantization} of {Even}-{Denominator} {Fractional} {Quantum} {Hall} {State} at nu=5/2 {Landau} {Level} {Filling} {Factor}},
	volume = {83},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/cond-mat/9907356},
	doi = {10.1103/PhysRevLett.83.3530},
	abstract = {We report ultra-low temperature experiments on the obscure fractional quantum Hall effect (FQHE) at Landau level filling factor \${\textbackslash}nu\$=5/2 in a very high mobility specimen of \${\textbackslash}mu=1.7 {\textbackslash}times 10{\textasciicircum}7\$ cm\${\textasciicircum}2\$/Vs. We achieve an electron temperature as low as \${\textbackslash}sim\$ 4{\textasciitilde}mK, where we observe vanishing \$R\_\{xx\}\$ and, for the first time, a quantized Hall resistance, \$R\_\{xy\}=h/(5/2e{\textasciicircum}2)\$ to within 2 ppm. \$R\_\{xy\}\$ at the neighboring odd-denominator states \${\textbackslash}nu\$=7/3 and 8/3 is also quantized. The temperature dependences of the \$R\_\{xx\}\$-minima at these fractional fillings yield activation energy gaps \${\textbackslash}Delta\_\{5/2\}\$=0.11K, \${\textbackslash}Delta\_\{7/3\}\$=0.10K, and \${\textbackslash}Delta\_\{8/3\}\$=0.055K.},
	number = {17},
	urldate = {2023-03-01},
	journal = {Physical Review Letters},
	author = {Pan, W. and Xia, J.-S. and Shvarts, V. and Adams, E. D. and Stormer, H. L. and Tsui, D. C. and Pfeiffer, L. N. and Baldwin, K. W. and West, K. W.},
	month = oct,
	year = {1999},
	note = {arXiv:cond-mat/9907356},
	keywords = {Condensed Matter - Mesoscale and Nanoscale Physics},
	pages = {3530--3533},
}

@article{dijkgraaf_quasi_1991,
	title = {Quasi hope algebras, group cohomology and orbifold models},
	volume = {18},
	issn = {0920-5632},
	url = {https://www.sciencedirect.com/science/article/pii/092056329190123V},
	doi = {10.1016/0920-5632(91)90123-V},
	abstract = {We construct non trivial quasi Hopf algebras associated to any finite group G and any element of H3(G, U(1)). We analyze in details the set of representations of these algebras and show that we recover the main interesting datas attached to particular orbifolds of Rational Conformal Field Theory or equivalently to the topological field theories studied by R. Dijkgraaf and E. Witten. This leads us to the construction of the R-matrix structure in non abelian RCFT orbifold models.},
	number = {2},
	urldate = {2023-04-06},
	journal = {Nuclear Physics B - Proceedings Supplements},
	author = {Dijkgraaf, R. and Pasquier, V. and Roche, P.},
	month = jan,
	year = {1991},
	pages = {60--72},
}

@misc{ma_fractional_2022,
	title = {Fractional quantum {Hall} effect at the filling factor nu=5/2},
	url = {http://arxiv.org/abs/2208.07908},
	doi = {10.48550/arXiv.2208.07908},
	abstract = {The fractional quantum Hall (FQH) effect at the filling factor \${\textbackslash}nu=5/2\$ was discovered in GaAs heterostructures more than 35 years ago. Various topological orders have been proposed as possible candidates to describe this FQH state. Some of them possess non-Abelian anyon excitations, an entirely new type of quasiparticle with fascinating properties. If observed, non-Abelian anyons could offer fundamental building blocks of a topological quantum computer. Nevertheless, the nature of the FQH state at \${\textbackslash}nu=5/2\$ is still under debate. In this chapter, we provide an overview of the theoretical background, numerical results, and experimental measurements pertaining to this special FQH state. Furthermore, we review some recent developments and their possible interpretations. Possible future directions toward resolving the nature of the \$5/2\$ state are also discussed.},
	urldate = {2023-04-02},
	publisher = {arXiv},
	author = {Ma, Ken K. W. and Peterson, Michael R. and Scarola, V. W. and Yang, Kun},
	month = sep,
	year = {2022},
	keywords = {Condensed Matter - Mesoscale and Nanoscale Physics, Condensed Matter - Strongly Correlated Electrons},
}

